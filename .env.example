# Database
POSTGRES_USER=eduagent
POSTGRES_PASSWORD=eduagent_dev
POSTGRES_DB=eduagent
DATABASE_URL=postgresql+asyncpg://eduagent:eduagent_dev@postgres:5432/eduagent

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
GEMINI_API_KEY=your-gemini-api-key-here
# Swap this if Google retires the model (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-flash-lite-latest

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
